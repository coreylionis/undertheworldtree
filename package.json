{
  "name": "undertheworldtree",
  "version": "1.0.0",
  "description": "Coreylionis.com or undertheworldtree is my personal website. \r The project is written in GatsbyJS, both for personal practice using a React framework and since the comprehensive API library and Javascript integration offer more customisation potential than Jekyll.",
  "main": "eslint.config.js",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "gatsby develop -o",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests!\" && exit 1",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public -c CNAME"
  },
  "repository": {
    "keywords": [
      "gatsby",
      "mdx"
    ],
    "type": "git",
    "url": "git+https://github.com/coreylionis/undertheworldtree",
    "bugs": {
      "url": "https://github.com/coreylionis/undertheworldtree/issues"
    }
  },
  "homepage": "https://github.com/coreylionis/undertheworldtree#readme",
  "dependencies": {
    "@fontsource-variable/grenze-gotisch": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "dompurify": "^3.4.17",
    "eslint-plugin-mdx": "^3.8.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-mdx": "^5.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-katex": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  },
  "allowScripts": {
    "gatsby@5.16.1": true,
    "gatsby-cli@5.16.0": true,
    "sharp@0.32.6": true
  }
}
